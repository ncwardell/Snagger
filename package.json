{
  "name": "snagger",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run server/server.ts",
    "dev:server": "bun --hot server/server.ts",
    "dev:ui": "cd ui && vite",
    "dev": "concurrently -k -n server,ui -c blue,green \"bun run dev:server\" \"bun run dev:ui\"",
    "build": "cd ui && vite build",
    "check": "cd ui && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "concurrently": "^9.1.0",
    "lucide-svelte": "^0.460.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "svelte-spa-router": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "moment": "^2.30.1"
  }
}
